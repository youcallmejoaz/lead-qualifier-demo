# Claude
ANTHROPIC_API_KEY=sk-ant-...
# Optional: defaults to the current Claude Sonnet model
ANTHROPIC_MODEL=claude-sonnet-5-5

# Airtable personal access token. Scopes: data.records:read, data.records:write,
# schema.bases:read (and schema.bases:write if you use setup-airtable --create-missing)
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...
# Optional table names
AIRTABLE_RUBRIC_TABLE=Rubric
AIRTABLE_LEADS_TABLE=Leads

# Optional: where the local SQLite source of truth lives
LQ_DB_PATH=lead_qualifier.db
LQ_ACCOUNTS_DIR=data/accounts
